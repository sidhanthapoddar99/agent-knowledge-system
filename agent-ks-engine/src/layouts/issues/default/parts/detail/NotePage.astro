---
/**
 * NotePage — full-page view of one supporting note from notes/.
 * Renders in standalone mode (one doc owns the DOM) or as a hidden panel
 * co-hosted under DetailBody (legacy).
 */
import path from 'path';
import type { IssueNote, IssueSection } from '@loaders/issues';
import { FREEFORM_SECTIONS, sectionById, sectionPanelKey } from '@loaders/issues';
import type { TocEntry } from '../../server/toc';

/** The note-shaped sections, straight from the registry — so adding another
 *  free-form section does not need this union edited by hand. */
type FreeformSectionId = (typeof FREEFORM_SECTIONS)[number]['id'];

interface Props {
  note: IssueNote & { toc?: TocEntry[] };
  standalone?: boolean;
  /** Which free-form section this doc lives under. Drives the path label and
   *  the panel-key namespace when NotePage is reused across them. */
  prefix?: FreeformSectionId;
}

const { note: n, standalone = false, prefix = 'notes' } = Astro.props;
// Use the real on-disk filename so the path label carries the true extension
// (`.md`, `.html` for an artifact, `.mmd`/… for a diagram) rather than assuming
// markdown.
const section = sectionById(prefix) as IssueSection;
const pathDisplay = [section.folder, ...n.groupPath, path.basename(n.filePath)].join('/');
const panelKey = sectionPanelKey(section, n.groupPath, n.name);
---

<section
  class={`issue-panel ${standalone ? 'is-active' : ''}`}
  data-panel={panelKey}
  role="tabpanel"
  hidden={!standalone}
>
  <div class="issue-doc">
    <div class="issue-doc__path">{pathDisplay}</div>
    <div class="issue-doc__body markdown-content">
      <Fragment set:html={n.html} />
    </div>
  </div>
</section>
