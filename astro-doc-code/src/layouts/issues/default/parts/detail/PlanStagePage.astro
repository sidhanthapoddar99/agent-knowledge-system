---
/**
 * PlanStagePage — one stage on its own URL.
 *
 * The sub-doc machinery gives every markdown file a route for free, so these
 * pages exist and stay reachable. Nothing links *to* them from the sidebar: the
 * single plan page is canonical, and two entry points for one piece of content
 * is tolerable where suppressing the route would be work for no gain.
 */
import type { Issue, IssuePlan, IssuePlanStage } from '@loaders/issues';
import { sectionById } from '@loaders/issues';
import { stateIconSvg } from '../../server/state-icon';
import {
  planUrl, planStagePanelKey, resolvePlanStage, subtaskUrl, logUrl,
} from '../../server/helpers';

interface Props {
  issue: Issue;
  plan: IssuePlan;
  stage: IssuePlanStage;
  baseUrl: string;
  statusColors: Record<string, string>;
  standalone?: boolean;
}

const { issue, plan, stage, baseUrl, statusColors, standalone = false } = Astro.props;
const relPath = `${sectionById('plans')!.folder}/${plan.name}/${stage.name}.md`;
const { subtasks, logs, missing } = resolvePlanStage(issue, stage);
---

<section
  class={`issue-panel ${standalone ? 'is-active' : ''}`}
  data-panel={planStagePanelKey(plan, stage)}
  role="tabpanel"
  hidden={!standalone}
>
  <div class="issue-doc">
    <div class="issue-doc__path">{relPath}</div>

    <div class="issue-plan__header">
      {stage.sequence !== null && <span class="issue-plan__num">{stage.sequence}</span>}
      <span class="issue-plan__title">{stage.title}</span>
      <span
        class="issue-plan__badge"
        style={statusColors[stage.status] ? `--badge-color: ${statusColors[stage.status]}` : undefined}
      >{stage.status}</span>
    </div>

    <p class="issue-plan__breadcrumb">
      Stage of <a href={planUrl(baseUrl, issue.id, plan)}>{plan.title}</a>
      {stage.outcome && <> — <em>{stage.outcome}</em></>}
      {stage.who && <> · waits on <strong>{stage.who}</strong></>}
    </p>

    {(subtasks.length > 0 || logs.length > 0) && (
      <div class="issue-plan__refs">
        {subtasks.map((s) => (
          <a class="issue-plan__ref" href={subtaskUrl(baseUrl, issue.id, s)} data-tip={s.status}>
            <span class="issue-plan__ref-icon" style={`color: ${statusColors[s.status] ?? 'currentColor'}`} set:html={stateIconSvg(s.status)} />
            <span>{s.title}</span>
          </a>
        ))}
        {logs.map((l) => (
          <a class="issue-plan__ref issue-plan__ref--log" href={logUrl(baseUrl, issue.id, l)}>
            <span>{l.name.replace(/[-_]/g, ' ')}</span>
          </a>
        ))}
      </div>
    )}

    {missing.length > 0 && (
      <div class="issue-plan__warning">
        <strong>{missing.length} reference{missing.length > 1 ? 's' : ''} resolve to nothing:</strong>
        <ul>{missing.map((ref) => <li><code>{ref}</code></li>)}</ul>
      </div>
    )}

    <div class="issue-doc__body markdown-content" set:html={stage.html} />
  </div>
</section>
