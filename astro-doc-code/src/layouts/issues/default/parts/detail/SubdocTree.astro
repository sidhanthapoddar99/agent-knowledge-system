---
/**
 * Recursively render a nested tree of notes or agent-logs in the sidebar.
 * Files at this level become <a> rows; subgroups become <details> blocks
 * that recursively render the same component for their inner tree.
 *
 * The depth cap (MAX_SUBFOLDER_DEPTH) is enforced upstream by the loader, so
 * this component doesn't need a guard — it stops naturally when `tree.groups`
 * is empty.
 */
import type { AgentLogKind, IssueAgentLog, IssueNote } from '@loaders/issues';
import { ISSUE_SECTIONS, sectionPanelKey } from '@loaders/issues';
import {
  sectionEntryUrl, pad,
  type GroupedTree,
} from '../../server/helpers';
import { agentLogIcon } from '../../server/agent-log-icons';
import { fileTypeIcon } from '../../../../file-type-icons';
import { parseOrderPrefixLoose, stripOrderPrefixLoose } from '@parsers/core/order-prefix';

type SubdocTree = GroupedTree<IssueNote> | GroupedTree<IssueAgentLog>;

interface Props {
  tree: SubdocTree;
  kind: 'note' | 'log' | 'brainstorm' | 'memory';
  baseUrl: string;
  issueId: string;
  activeKey: string;
  /** Add the `--nested` modifier to the items wrapper (for sub-levels). */
  nested?: boolean;
  /** Folder-path prefix for the collapse-cache key (e.g. `notes`, `notes/design`). */
  pathPrefix?: string;
  /** Agent-log kind code → {name, icon} (effective map). Only used for `kind==='log'`. */
  kindMap?: Record<string, AgentLogKind>;
  /** Agent-log folder path (joined with `/`, relative to `agent-log/`) → its
   *  status, or `null` when the folder ships no `settings.json`. A folder absent
   *  from this map and a folder mapped to `null` mean the same thing and render
   *  the same defined grey. Only used for `kind==='log'`. */
  statusMap?: Record<string, string | null>;
  /** Resolved seven-status colour map — the same one every other status surface
   *  reads, so a tracker overriding `fields.status.colors` restyles this too. */
  statusColors?: Record<string, string>;
  /** This node's path relative to `agent-log/` — the key into `statusMap`.
   *  Accumulated on the way down; `''` at the root. */
  groupKey?: string;
}

/** The registry entry this tree is drawing. Every path, key and URL below comes
 *  from it, so the tree cannot address a section by a name it remembered — the
 *  way a new section's sidebar links silently pointed at `notes/`. */
const sectionOf = (k: Props['kind']) => ISSUE_SECTIONS.find((s) => s.subDocKind === k)!;

const {
  tree, kind, baseUrl, issueId, activeKey, nested = false, kindMap = {},
  statusMap = {}, statusColors = {}, groupKey = '',
  pathPrefix = sectionOf(Astro.props.kind).id,
} = Astro.props;

const section = sectionOf(kind);

/** For an agent-log activity folder `NNN_<code>_<name>`: after stripping the order
 *  prefix, if the remainder starts with a known two-letter kind code + `_`, split
 *  it into { kind: <AgentLogKind>, label: <clean name> }. Otherwise no kind. */
function logFolderParts(groupName: string): { kind: AgentLogKind | null; label: string } {
  if (kind === 'log') {
    const rest = stripOrderPrefixLoose(groupName);
    const m = rest.match(/^([a-z]{2})_(.+)$/);
    if (m && kindMap[m[1]]) {
      return { kind: kindMap[m[1]], label: m[2].replace(/[-_]/g, ' ').trim() };
    }
  }
  return { kind: null, label: cleanLabel(groupName) };
}

/** Human-readable label: prefix stripped, separators → spaces. Shared by files
 *  and folders, all kinds. */
function cleanLabel(name: string): string {
  return stripOrderPrefixLoose(name).replace(/[-_]/g, ' ').trim() || name;
}

/** Common ordering badge — the padded `NN` prefix, same rule for every kind and
 *  for both files and folders. Empty string when the name has no prefix. */
function prefixNum(name: string): string {
  return pad(parseOrderPrefixLoose(name).position);
}

/** Numeric *value* of the order prefix, for value-based sorting (so mixed widths
 *  like `20_` and `100_` order by value, not lexically). Unprefixed → +∞ (last). */
function prefixValue(name: string): number {
  const p = parseOrderPrefixLoose(name).position;
  return p === null ? Number.POSITIVE_INFINITY : p;
}

/**
 * Leading badge for a leaf — the padded `NN` prefix, one rule for every kind.
 *
 * Agent-log entries used to override this with a separate `#<iteration>` badge,
 * numbered from `iteration:` frontmatter. That badge is gone — milestones no
 * longer exist and the `NNN_` filename owns the number, so historic files still
 * carrying `iteration:` render their filename prefix like everything else.
 *
 * The number is TINTED by the file's own `status` where it declares one (see
 * `leafNumColor`), which is the round-level signal: the agent-log folder's dot
 * says how the whole run went, and a round inside it can have failed while the
 * run finished. One number, doing both jobs, instead of a second badge.
 */
function leafNum(item: IssueNote | IssueAgentLog): string {
  return prefixNum(item.name);
}

/**
 * Colour for a leaf's prefix number, when the file declares a status.
 *
 * **Both halves must be present**: a parseable `NNN_` prefix (there is nothing
 * to tint otherwise) and a `status` in frontmatter that is one of the fixed
 * seven. A file with no status keeps the default number colour — untinted means
 * "said nothing", which has to stay distinguishable from any status it might
 * have declared.
 *
 * This is the round-level signal. The agent-log FOLDER's dot
 * (`folderStatusColor`) says how the whole run went; a round inside it can have
 * failed while the run finished, and that fact had nowhere to show before.
 *
 * A status is deliberately NOT the whole story on a failed round: the validator
 * also asks for a callout saying what failed, because a colour is scannable but
 * says nothing about why.
 */
function leafNumColor(item: IssueNote | IssueAgentLog): { color: string; label: string } | null {
  const status = (item as { status?: string | null }).status;
  if (!status) return null;
  const color = statusColors[status];
  if (!color) return null;                       // unknown value — the validator reports it
  return { color, label: status };
}

/**
 * Colour for an agent-log folder's status dot.
 *
 * Absent status resolves to a **defined** muted token rather than falling
 * through to "no colour": a folder that never declared a status must be
 * visually distinguishable from one that declared `open`, or the signal is lost
 * in exactly the case nobody writes a fixture for.
 */
const AGENT_LOG_STATUS_UNSET = 'var(--color-text-muted)';
function folderStatusColor(key: string): { color: string; label: string } | null {
  if (kind !== 'log') return null;
  if (!(key in statusMap)) return null;          // a plain grouping folder — no dot at all
  const status = statusMap[key];
  if (!status) return { color: AGENT_LOG_STATUS_UNSET, label: 'no status set' };
  return { color: statusColors[status] ?? AGENT_LOG_STATUS_UNSET, label: status };
}

function leafLabel(item: IssueNote | IssueAgentLog): string {
  return cleanLabel(item.name);
}

function leafKey(item: IssueNote | IssueAgentLog): string {
  return sectionPanelKey(section, item.groupPath, item.name);
}

function leafHref(item: IssueNote | IssueAgentLog): string {
  return sectionEntryUrl(baseUrl, issueId, section, item.groupPath, item.name);
}

/** Total descendants under a tree node — used for the subgroup count. */
function descendantCount(t: SubdocTree): number {
  let n = t.files.length;
  for (const child of t.groups.values()) n += descendantCount(child);
  return n;
}

/** Does any descendant match the active key? Drives auto-expand on load. */
function containsActive(t: SubdocTree): boolean {
  if (t.files.some((f) => leafKey(f) === activeKey)) return true;
  for (const child of t.groups.values()) {
    if (containsActive(child)) return true;
  }
  return false;
}

/** A renderable entry at this tree level — a leaf file or a subgroup folder.
 *  Files and folders are interleaved and ordered by the precedence chain below
 *  (`memory.md` pin → numeric prefix value → lexicographic), so a numbered
 *  folder slots in among numbered files by value instead of by string.
 *
 *  That interleaving is what makes an agent log's `01_summary.md` (a file),
 *  `02_working/` and `03_debrief/` (folders) and its child activities at `100_`
 *  and up fall into one correct order with no special case. */
interface SubdocEntry {
  kind: 'leaf' | 'group';
  sortName: string;
  item?: IssueNote | IssueAgentLog;
  groupName?: string;
  child?: SubdocTree;
}

// `tree` is a union (`GroupedTree<IssueNote> | GroupedTree<IssueAgentLog>`), so
// `.files` / `.groups` are union-typed; TS can't call across the union. Widen to
// the union element types — every downstream use already treats them as such.
const treeFiles = tree.files as (IssueNote | IssueAgentLog)[];
const treeGroups = tree.groups as Map<string, SubdocTree>;
const entries: SubdocEntry[] = [
  ...treeFiles.map((item): SubdocEntry => ({ kind: 'leaf', sortName: item.name, item })),
  ...Array.from(treeGroups, ([groupName, child]): SubdocEntry => ({ kind: 'group', sortName: groupName, groupName, child })),
];

/**
 * Ordering — precedence chain:
 *   0. `memory.md` pin (agent-memory only): the section's index / entry point
 *      always sorts first. It carries no prefix, so nothing else can express it.
 *   1. Numeric prefix *value* — so mixed widths (`20_` vs `100_`) order by value,
 *      not lexically. Unprefixed sorts last (+∞).
 *   2. Lexicographic on the raw name — the final tie-break.
 *
 * **An agent log needs no pin.** There used to be a `summary.md`-sorts-first
 * rule here, matching the file by NAME. The run's slots are now numbered —
 * `01_summary.md`, `02_working/`, `03_debrief/`, then child activities at `100_`
 * and up — so the read order the pin was enforcing is the prefix order, and the
 * special case could be deleted rather than renamed. That is the point of the
 * numbering: the order is stated where every other section states it.
 */
entries.sort((a, b) => {
  if (kind === 'memory') {
    const aPin = a.kind === 'leaf' && a.sortName === 'memory' ? 0 : 1;
    const bPin = b.kind === 'leaf' && b.sortName === 'memory' ? 0 : 1;
    if (aPin !== bPin) return aPin - bPin;                                 // 0. index pin
  }
  const av = prefixValue(a.sortName), bv = prefixValue(b.sortName);
  if (av !== bv) return av - bv;                                           // 1. prefix value
  return a.sortName.localeCompare(b.sortName);                            // 2. lexicographic
});
---

<div class={`issue-sidebar__items ${nested ? 'issue-sidebar__items--nested' : ''}`}>
  {entries.map((entry) => {
    if (entry.kind === 'leaf') {
      const item = entry.item!;
      const key = leafKey(item);
      const isActive = activeKey === key;
      const label = leafLabel(item);
      const num = leafNum(item);
      const color = (item as { color?: string | null }).color ?? null;
      // Type marker: non-markdown sub-docs (`.html` artifacts, first-class
      // diagrams) get a small glyph so they're distinguishable from a markdown
      // note at a glance. Markdown is the default and stays unmarked. Shared
      // vocabulary with the docs sidebar: `src/layouts/file-type-icons.ts`.
      const typeIcon = fileTypeIcon((item as { docType?: string }).docType);
      return (
        <a
          href={leafHref(item)}
          class={`issue-sidebar__item ${isActive ? 'is-active' : ''}`}
          aria-current={isActive ? 'page' : undefined}
          data-tip={label}
        >
          {num && (
            <span
              class="issue-sidebar__num"
              style={leafNumColor(item) ? `color: ${leafNumColor(item)!.color}` : undefined}
              data-tip={leafNumColor(item)?.label}
            >{num}</span>
          )}
          <span class="issue-sidebar__label" style={color ? `color: ${color}` : undefined}>{label}</span>
          {typeIcon && (
            <span class="issue-sidebar__doctype" data-tip={typeIcon.label} data-tip-always aria-label={typeIcon.label} set:html={typeIcon.svg} />
          )}
        </a>
      );
    }
    const groupName = entry.groupName!;
    const child = entry.child!;
    const open = containsActive(child);
    const childPath = `${pathPrefix}/${groupName}`;
    const childGroupKey = groupKey ? `${groupKey}/${groupName}` : groupName;
    const { kind: groupKind, label: groupLabel } = logFolderParts(groupName);
    const groupNum = prefixNum(groupName);
    const folderStatus = folderStatusColor(childGroupKey);
    // Row: `NN  <symbol>  <name>  …  <count>` — the numeric prefix leads, then
    // the kind symbol, the clean name, and the file count on the right.
    //
    // Number before symbol, decided by Sid on the built page after a round with
    // it the other way round. The case for symbol-first was that a
    // status-coloured icon gives the column one vertical run to scan; on screen,
    // the number turned out to be what a reader is looking for here, because an
    // activity is referred to BY its number everywhere else — "run 020" — while
    // its kind is a property of the run rather than its name.
    //
    // Deliberately NOT the arrangement on subtask and plan rows, where the status
    // icon still leads. Those are read for STATE ("what is left"); an activity row
    // is read for IDENTITY ("which run"). One tree, two questions.
    return (
      <details class="issue-sidebar__subgroup" data-collapse-key={childPath} open={open ? true : undefined}>
        <summary class="issue-sidebar__subgroup-heading" data-tip={groupLabel}>
          <svg class="issue-sidebar__chevron" width="10" height="10" viewBox="0 0 10 10" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M2 3l3 3 3-3"/></svg>
          {groupNum && <span class="issue-sidebar__num">{groupNum}</span>}
          {groupKind && (
            <span
              class="issue-sidebar__kind"
              style={folderStatus ? `color: ${folderStatus.color}` : undefined}
              data-tip={folderStatus ? `${groupKind.name} · ${folderStatus.label}` : groupKind.name}
              data-tip-always
              aria-label={folderStatus ? `${groupKind.name}, ${folderStatus.label}` : groupKind.name}
            >
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={agentLogIcon(groupKind.icon)} />
            </span>
          )}
          <span class="issue-sidebar__subgroup-name">{groupLabel}</span>
          <span class="issue-sidebar__heading-count">{descendantCount(child)}</span>
        </summary>
        <Astro.self
          tree={child}
          kind={kind}
          baseUrl={baseUrl}
          issueId={issueId}
          activeKey={activeKey}
          nested={true}
          pathPrefix={childPath}
          groupKey={childGroupKey}
          kindMap={kindMap}
          statusMap={statusMap}
          statusColors={statusColors}
        />
      </details>
    );
  })}
</div>
