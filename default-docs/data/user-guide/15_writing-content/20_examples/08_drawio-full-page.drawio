<mxfile host="agent-knowledge-system" version="31.1.5">
  <diagram id="drawio-full-page" name="Rendering pipeline">
    <mxGraphModel dx="960" dy="620" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="900" pageHeight="620" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="lane-build" value="Build" style="swimlane;html=1;startSize=28;horizontal=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="scan" value="loadDiagramPages()&#xa;scans for NN_*.drawio" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane-build">
          <mxGeometry x="30" y="50" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="container" value="emits a .diagram-drawio&#xa;placeholder with data-src" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane-build">
          <mxGeometry x="30" y="145" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="be1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="lane-build" source="scan" target="container">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="lane-browser" value="Browser" style="swimlane;html=1;startSize=28;horizontal=1;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="40" width="380" height="340" as="geometry" />
        </mxCell>
        <mxCell id="fetch" value="fetch the .drawio file&#xa;from /content-assets" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane-browser">
          <mxGeometry x="30" y="50" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="load" value="lazy-load the vendored&#xa;GraphViewer bundle" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="lane-browser">
          <mxGeometry x="30" y="140" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="render" value="render SVG in the theme&#xa;the site is currently in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="lane-browser">
          <mxGeometry x="30" y="230" width="200" height="55" as="geometry" />
        </mxCell>
        <mxCell id="re1" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="lane-browser" source="fetch" target="load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="re2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;" edge="1" parent="lane-browser" source="load" target="render">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="cross" value="data-src" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;labelBackgroundColor=none;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="container" target="fetch">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="445" y="212" />
              <mxPoint x="445" y="117" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="toggle" value="theme toggle" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="180" y="330" width="140" height="70" as="geometry" />
        </mxCell>
        <mxCell id="rebuild" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="toggle" target="lane-browser">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="565" y="365" />
              <mxPoint x="565" y="410" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="toggle-note" value="A theme flip rebuilds the viewer so the&#xa;palette is re-resolved — draw.io is the one&#xa;format that is not colour-inverted by CSS." style="text;html=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="420" width="380" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
