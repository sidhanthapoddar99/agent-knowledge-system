---
/**
 * SubDocLayout — standalone page for one subtask, note, or agent-log entry.
 *
 * Reuses DetailSidebar (mode: 'subdoc') and renders a single sub-doc in
 * <main>. Right rail is a simplified TOC for this doc only. Sub-doc headings
 * keep their native IDs because this page has only one document in the DOM.
 */
import DetailSidebar from './parts/detail/DetailSidebar.astro';
import SubtaskPage from './parts/detail/SubtaskPage.astro';
import NotePage from './parts/detail/NotePage.astro';
import AgentLogPage from './parts/detail/AgentLogPage.astro';
import PlanPage from './parts/detail/PlanPage.astro';
import PlanStagePage from './parts/detail/PlanStagePage.astro';
import SubDocMetaSidebar from './parts/detail/SubDocMetaSidebar.astro';
import MetaPanel from './parts/shared/MetaPanel.astro';
import { allStateIcons } from './server/state-icon';
import { extractToc } from './server/toc';
import { sortSubtasksByState, terminalStartIndex, TERMINAL, logPanelKey, subtaskPanelKey, planPanelKey, planStagePanelKey } from './server/helpers';
import { FREEFORM_SECTIONS, sectionPanelKey } from '@loaders/issues';
import type { Issue, IssuesVocabulary, IssueSubtask, IssueNote, IssueAgentLog, IssuePlan, IssuePlanStage } from '@loaders/issues';
import './styles/detail.css';

interface Props {
  issue: Issue;
  vocabulary: IssuesVocabulary;
  baseUrl: string;
  subDoc:
    | { kind: 'subtask'; subtask: IssueSubtask }
    | { kind: 'note'; note: IssueNote }
    | { kind: 'brainstorm'; brainstorm: IssueNote }
    | { kind: 'memory'; memory: IssueNote }
    | { kind: 'log'; log: IssueAgentLog }
    | { kind: 'plan'; plan: IssuePlan }
    | { kind: 'plan-stage'; plan: IssuePlan; stage: IssuePlanStage };
}

const { issue, vocabulary, baseUrl, subDoc } = Astro.props;
const { meta } = issue;

const sortedSubtasks = sortSubtasksByState(issue.subtasks);
const terminalStartIdx = terminalStartIndex(sortedSubtasks);
const subtaskDone = issue.subtasks.filter((s) => TERMINAL.includes(s.status)).length;
const subtaskReview = issue.subtasks.filter((s) => s.category === 'review').length;
const statusColors = vocabulary.fields?.status?.colors || {};

// Artifact sub-docs get the full content width: an artifact has no headings,
// so the TOC rail would be dead chrome — hide it and let the embed claim the
// outline column (the tracker twin of the docs outline auto-hide).
const isArtifactDoc =
  (subDoc.kind === 'note' && subDoc.note.docType === 'artifact') ||
  (subDoc.kind === 'brainstorm' && subDoc.brainstorm.docType === 'artifact');

// Every free-form section renders the same page with a different prefix, so
// they resolve through the registry rather than one `subDoc.kind === …` arm
// each: a section added to the registry renders here without being remembered.
// The prop name is the sub-doc kind by construction (see `resolveSubDoc`), so
// the entry is read by kind rather than through a second per-section list.
const freeform = (() => {
  const section = FREEFORM_SECTIONS.find((s) => s.subDocKind === subDoc.kind);
  if (!section) return null;
  return { section, note: (subDoc as Record<string, unknown>)[subDoc.kind] as IssueNote };
})();

let activeKey: string;
let toc;
if (freeform) {
  // One arm for every free-form section. Adding one used to mean adding a
  // fourth `else if` here that looked exactly like the other three.
  activeKey = sectionPanelKey(freeform.section, freeform.note.groupPath, freeform.note.name);
  toc = extractToc(freeform.note.html);
} else if (subDoc.kind === 'subtask') {
  activeKey = subtaskPanelKey(subDoc.subtask);
  toc = extractToc(subDoc.subtask.html);
} else if (subDoc.kind === 'plan') {
  activeKey = planPanelKey(subDoc.plan);
  // The plan page's outline is its STAGES, not the headings inside them — nine
  // stages each carrying `## Todo` would make the rail unreadable and say
  // nothing. Built from the stage list directly rather than scraped back out of
  // the rendered HTML.
  toc = subDoc.plan.stages.map((s) => ({ id: s.anchor, level: 1, text: s.title }));
} else if (subDoc.kind === 'plan-stage') {
  activeKey = planStagePanelKey(subDoc.plan, subDoc.stage);
  toc = extractToc(subDoc.stage.html);
} else {
  activeKey = logPanelKey(subDoc.log);
  toc = extractToc(subDoc.log.html);
}
---

<div class:list={['issue-layout', { 'issue-layout--artifact': isArtifactDoc }]}>
  <DetailSidebar
    baseUrl={baseUrl}
    issue={issue}
    sortedSubtasks={sortedSubtasks}
    terminalStartIdx={terminalStartIdx}
    subtaskDone={subtaskDone}
    subtaskReview={subtaskReview}
    mode="subdoc"
    activeKey={activeKey}
    statusColors={statusColors}
  />

  <main class="issue-main">
    <header class="issue-main__header">
      <h1 class="issue-main__title">{meta.title}</h1>
      <MetaPanel issue={issue} vocabulary={vocabulary} />
    </header>

    {subDoc.kind === 'subtask' && (
      <SubtaskPage subtask={subDoc.subtask} statusColors={statusColors} standalone />
    )}
    {freeform && (
      <NotePage note={freeform.note} standalone prefix={freeform.section.id} />
    )}
    {subDoc.kind === 'log' && (
      <AgentLogPage log={subDoc.log} standalone />
    )}
    {subDoc.kind === 'plan' && (
      <PlanPage issue={issue} plan={subDoc.plan} baseUrl={baseUrl} statusColors={statusColors} standalone />
    )}
    {subDoc.kind === 'plan-stage' && (
      <PlanStagePage issue={issue} plan={subDoc.plan} stage={subDoc.stage} baseUrl={baseUrl} statusColors={statusColors} standalone />
    )}
  </main>

  {!isArtifactDoc && <SubDocMetaSidebar toc={toc} />}
</div>

<script is:inline type="application/json" id="subtask-state-icons" set:html={JSON.stringify(allStateIcons())} />

<script>
  import { initIssuesDetail } from './scripts/detail/client';
  initIssuesDetail();
</script>
