---
/**
 * AgentLogPage — full-page view of one file inside an agent log.
 * Renders in standalone mode (its own URL) or as a hidden panel (legacy).
 */
import type { IssueAgentLog } from '@loaders/issues';
import type { TocEntry } from '../../server/toc';
import { sectionById } from '@loaders/issues';
import { logPanelKey } from '../../server/helpers';

interface Props {
  log: IssueAgentLog & { toc?: TocEntry[] };
  statusColors: Record<string, string>;
  standalone?: boolean;
}

const { log, statusColors, standalone = false } = Astro.props;
const pathDisplay = [sectionById('agent-log')!.folder, ...log.groupPath, `${log.name}.md`].join('/');
---

<section
  class={`issue-panel ${standalone ? 'is-active' : ''}`}
  data-panel={logPanelKey(log)}
  role="tabpanel"
  hidden={!standalone}
>
  <div class="issue-doc">
    <div class="issue-log__header">
      <span class="issue-doc__path">{pathDisplay}</span>
      <div class="issue-log__meta">
        {log.agent && <span class="issue-log__chip">{log.agent}</span>}
        {log.status && (
          <span
            class="issue-log__chip"
            style={statusColors[log.status] ? `--badge-color: ${statusColors[log.status]}` : undefined}
          >{log.status}</span>
        )}
        {log.date && <span class="issue-log__chip">{log.date}</span>}
      </div>
    </div>
    <div class="issue-doc__body markdown-content">
      <Fragment set:html={log.html} />
    </div>
  </div>
</section>
