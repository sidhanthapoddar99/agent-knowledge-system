#!/usr/bin/env bash
# Thin shim. The implementation is scripts/start.mjs — one file, all platforms.
# This stays at the repo root because `./start` is the documented entry point in
# the README, CLAUDE.md and the user guide; moving it would break every consumer.
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if command -v bun >/dev/null 2>&1; then exec bun "$DIR/scripts/start.mjs" "$@"; fi
if command -v node >/dev/null 2>&1; then exec node "$DIR/scripts/start.mjs" "$@"; fi
echo "[start] error: neither bun nor node found on PATH — install one and retry" >&2
exit 1
