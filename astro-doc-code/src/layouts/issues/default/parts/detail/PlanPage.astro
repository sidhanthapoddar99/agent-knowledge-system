---
/**
 * PlanPage — the single page for one plan: `overview.md`, then the plan table,
 * then every stage inlined under a generated heading.
 *
 * Two things here are load-bearing rather than cosmetic:
 *
 *   1. **The table IS the index.** A separate generated list of the same stages
 *      would be duplication in the UI, which is the same defect as duplication
 *      on disk. The Stage cell links to the stage's anchor; that is the index.
 *
 *   2. **Headings anchor on the TITLE, never the prefix.** `move` rewrites
 *      paths on a renumber but not anchors, so `#20-journal-compatibility`
 *      would break silently the first time a stage is inserted above it.
 *
 *   3. **The table is styled as an ordinary markdown table**, by wrapping it in
 *      `.markdown-content` rather than restating those rules under a bespoke
 *      class. A hand-copied border and link colour is the same duplication
 *      defect as any other: it drifts the first time the markdown styles move,
 *      and a table that looks *almost* like the prose around it reads as a bug.
 *
 * The stage's subtasks are NOT summarised as counts here. They are listed by
 * name, with live status icons, under the stage's own heading below — the same
 * fact, linked instead of tallied.
 */
import type { Issue, IssuePlan, IssueStatus } from '@loaders/issues';
import { sectionById } from '@loaders/issues';
import { stateIconSvg } from '../../server/state-icon';
import { STATUS_LABELS } from '@loaders/issue-status';
import {
  pad, planStageUrl, planPanelKey, resolvePlanStage, subtaskUrl,
  subtaskOrderingPath,
  planDocument, PLAN_OVERVIEW_ANCHOR, PLAN_STAGES_ANCHOR,
} from '../../server/helpers';

interface Props {
  issue: Issue;
  plan: IssuePlan;
  baseUrl: string;
  statusColors: Record<string, string>;
  standalone?: boolean;
}

const { issue, plan, baseUrl, statusColors, standalone = false } = Astro.props;
const relPath = `${sectionById('plans')!.folder}/${plan.name}/`;

// `planDocument` owns the id-prefixing and the table of contents; the right
// rail in SubDocLayout calls the SAME function, so it cannot list a section this
// page did not render. See its docblock for why every id is prefixed.
const doc = planDocument(plan);
const resolved = doc.stages.map(({ stage, html }) => ({
  stage,
  html,
  ...resolvePlanStage(issue, stage),
}));
const missingTotal = resolved.reduce((n, r) => n + r.missing.length, 0);
---

<section
  class={`issue-panel ${standalone ? 'is-active' : ''}`}
  data-panel={planPanelKey(plan)}
  role="tabpanel"
  hidden={!standalone}
>
  <div class="issue-doc">
    <div class="issue-doc__path">{relPath}</div>

    <div class="issue-plan__header">
      {plan.sequence !== null && <span class="issue-plan__num">{pad(plan.sequence)}</span>}
      <span class="issue-plan__title">{plan.title}</span>
      <span
        class="issue-plan__badge"
        style={statusColors[plan.status] ? `--badge-color: ${statusColors[plan.status]}` : undefined}
      >{plan.status}</span>
    </div>

    {doc.overviewHtml && (
      <div id={PLAN_OVERVIEW_ANCHOR} class="issue-doc__body markdown-content" set:html={doc.overviewHtml} />
    )}

    {plan.stages.length === 0 ? (
      <div class="issue-doc__empty">
        <p class="issue-doc__empty-title">No stages yet</p>
        <p>
          A plan is a folder of stages — <code>NN_&lt;name&gt;.md</code>, gap-spaced by
          ten so there is room to insert. Add one, or scaffold it with
          <code>agent-ks issue new-stage</code>.
        </p>
      </div>
    ) : (
      <div class="markdown-content issue-plan__table-wrap">
        <h2 id={PLAN_STAGES_ANCHOR} class="issue-plan__section-heading">Stages</h2>
        <div class="table-wrapper">
          <table class="issue-plan__table">
            <thead>
              <tr>
                <th class="issue-plan__col-id">#</th>
                <th>Stage</th>
                <th class="issue-plan__col-status">Status</th>
                <th class="issue-plan__col-who">Who</th>
                <th>Outcome</th>
                <th>Notes</th>
              </tr>
            </thead>
            <tbody>
              {resolved.map(({ stage }) => (
                <tr>
                  <td class="issue-plan__col-id">{stage.sequence !== null ? stage.sequence : '—'}</td>
                  <td><a href={`#${stage.anchor}`}>{stage.title}</a></td>
                  <td class="issue-plan__col-status">
                    <span
                      class="issue-plan__state"
                      style={`color: ${statusColors[stage.status] ?? 'currentColor'}`}
                      data-tip={STATUS_LABELS[stage.status] ?? stage.status}
                      data-tip-always
                      aria-label={STATUS_LABELS[stage.status] ?? stage.status}
                      set:html={stateIconSvg(stage.status)}
                    />
                  </td>
                  <td class="issue-plan__col-who">{stage.who ?? ''}</td>
                  <td set:html={stage.outcomeHtml ?? ''} />
                  <td class="issue-plan__notes" set:html={stage.notesHtml ?? ''} />
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    {missingTotal > 0 && (
      <div class="issue-plan__warning">
        <strong>{missingTotal} reference{missingTotal > 1 ? 's' : ''} in this plan resolve to nothing.</strong>
        A stage that references a subtask which no longer exists silently under-counts
        its own progress, so the broken refs are named here rather than dropped:
        <ul>
          {resolved.flatMap(({ stage, missing }) =>
            missing.map((ref) => <li><code>{stage.name}</code> → <code>{ref}</code></li>),
          )}
        </ul>
      </div>
    )}

    {resolved.map(({ stage, html, subtasks }) => (
      <div class="issue-plan__stage markdown-content">
        <h1 id={stage.anchor}>
          <a class="issue-plan__stage-link" href={planStageUrl(baseUrl, issue.id, plan, stage)}>
            {stage.sequence !== null && <span class="issue-plan__stage-num">{stage.sequence}</span>}
            {stage.title}
          </a>
        </h1>
        <hr />
        {subtasks.length > 0 && (
          <ul class="issue-plan__refs">
            {subtasks.map((s) => (
              <li class="issue-plan__ref">
                <span
                  class="issue-plan__ref-icon"
                  style={`color: ${statusColors[s.status] ?? 'currentColor'}`}
                  data-tip={STATUS_LABELS[s.status] ?? s.status}
                  data-tip-always
                  aria-label={STATUS_LABELS[s.status] ?? s.status}
                  set:html={stateIconSvg(s.status)}
                />
                <a href={subtaskUrl(baseUrl, issue.id, s)}>
                  {subtaskOrderingPath(s) && <span class="issue-plan__ref-num">{subtaskOrderingPath(s)}</span>}
                  {s.title}
                </a>
              </li>
            ))}
          </ul>
        )}
        <div class="issue-doc__body" set:html={html} />
      </div>
    ))}
  </div>
</section>
